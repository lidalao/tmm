# Raw 文件只放一行明文 Token；使用分支地址，不要固定到 commit SHA。
TM_TOKEN_URL=https://raw.githubusercontent.com/lidalao/tmm/main/token.txt

# 单位：秒。每天一次为 86400；每小时一次为 3600。
TM_CHECK_INTERVAL=86400
# 网络或更新失败后，等待多少秒再试。
TM_RETRY_INTERVAL=300

# 每台 VPS 可设置自己的设备名称。
TM_DEVICE_NAME=tm
# x86_64 使用 latest；ARM64 按官方镜像选择 arm64v8。
TM_IMAGE=traffmonetizer/cli_v2:latest
TM_USER=0
TM_START_GRACE=10

# 通常无需修改；同一台机器部署多套时必须分别设置。
COMPOSE_PROJECT_NAME=tm-stack
TM_CONTAINER_NAME=tm
